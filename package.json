{
  "name": "floxt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "tauri": "tauri",
    "tauri:dev:withidentity": "...",
    "pack:msix": "npm run tauri -- build && (if not exist dist mkdir dist) && (if not exist dist\\icons mkdir dist\\icons) && copy /Y src-tauri\\target\\release\\Floxt.exe dist\\ && copy /Y src-tauri\\icons\\* dist\\icons\\ && winapp pack .\\dist --output .\\Floxt.msix --cert .\\devcert.pfx"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
