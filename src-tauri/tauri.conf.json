{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Floxt",
  "version": "1.0.0",
  "identifier": "HubertDoliski.Floxt",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Floxt",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Hubert Dolinski",
    "shortDescription": "Fast and capable note-taking",
    "longDescription": "Fast and capable note-taking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Square150x150Logo.png",
      "icons/Square44x44Logo.png",
      "icons/StoreLogo.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header_floxt.bmp",
        "sidebarImage": "installer/sidebar_floxt.bmp"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "fileAssociations": [
      {
        "ext": ["floxt"],
        "name": "Floxt Note",
        "description": "Floxt Note",
        "role": "Editor"
      }
    ]
  }
}
